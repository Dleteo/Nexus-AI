# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider: use "gemini" for the available free tier, or "openai" for OpenAI API.
AI_PROVIDER=gemini

# Server-only Gemini API key. Create it in Google AI Studio; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI alternative. Requires separate OpenAI API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-only Supabase secret key used for privileged assistant RPCs.
# Create a secret key in Supabase Settings -> API Keys. Never use NEXT_PUBLIC_ or commit the real value.
SUPABASE_SECRET_KEY=

# Nexus Core — local Ollama inference. Local development only, no cloud model.
# Install Ollama, run: ollama pull qwen3:4b, then set AI_PROVIDER=ollama above.
# No AI-provider API key required. Existing Supabase Auth/storage still applies.
NEXUS_CORE_ENABLED=false
OLLAMA_MODEL=qwen3:4b
