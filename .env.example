# Copy to .env.local. Do NOT commit credentials or real user data.
# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only Supabase overrides take precedence over NEXT_PUBLIC_*.
# Keep URL/key pairs for the same project. Isolated API tests set these to loopback.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY

# Select a provider explicitly; never automatically use a key found in the environment.
# Options: foundation (technical-only, development-only, own offline rules), ollama (local), gemini (external), openai (external).
# Each assistant can use a different provider, falling back to AI_PROVIDER.
AI_PROVIDER=ollama
AI_PORTFOLIO_PROVIDER=ollama
AI_TECHNICAL_PROVIDER=foundation

# Nexus Foundation: required only when AI_TECHNICAL_PROVIDER=foundation.
# SAME Windows PC as the local Next.js development server. NEVER use NEXT_PUBLIC_ for these paths.
# Set absolute paths to the existing private Nexus Foundation checkout and its installed Python.
# Provider works only in NODE_ENV=development. It is offline, based on rules/sources, NOT neural chat.
# NEXUS_FOUNDATION_PYTHON=C:/Users/YOUR_USER/path-to-old-venv/Scripts/python.exe
# NEXUS_FOUNDATION_ROOT=C:/Users/YOUR_USER/path-to-Nexus-Foundation-Dev

# Ollama: local inference without per-request cloud fees (hardware/electricity still cost).
# Run Ollama on the SAME server as Next.js, not exposed to the public internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional external providers. Their pricing, free tiers and data terms can change.
# Never prefix these keys with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Secret key for server-only privileged assistant RPCs. Never publish it.
SUPABASE_SECRET_KEY=
