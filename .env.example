# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider: choose explicitly: "ollama" for a local model, "gemini" for its currently available free-tier options (subject to quotas/terms), or "openai" for the paid OpenAI API.\n# No provider is selected automatically. Nexus AI owns its interface, logic and saved data.
AI_PROVIDER=ollama
# Optional independent engines: Nexus Portfolio can stay local while Nexus Technical uses a hosted free tier.
# Example: AI_PORTFOLIO_PROVIDER=ollama and AI_TECHNICAL_PROVIDER=gemini
AI_PORTFOLIO_PROVIDER=ollama
AI_TECHNICAL_PROVIDER=ollama

# Server-only Gemini API key. Create it in Google AI Studio; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free of per-request provider fees locally; requires your own CPU/GPU, memory, download and electricity.\n# Ollama must run on the SAME machine as the Next.js server for the secure loopback URL.\nOLLAMA_BASE_URL=http://127.0.0.1:11434\nOLLAMA_MODEL=gemma3:4b\n\n# Optional OpenAI alternative. Requires separate OpenAI API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-only Supabase secret key used for privileged assistant RPCs.
# Create a secret key in Supabase Settings -> API Keys. Never use NEXT_PUBLIC_ or commit the real value.
SUPABASE_SECRET_KEY=
