# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_KEY

# AI provider: use "gemini" for the available free tier, or "openai" for OpenAI API.
AI_PROVIDER=gemini

# Server-only Gemini API key. Create it in Google AI Studio; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI alternative. Requires separate OpenAI API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
